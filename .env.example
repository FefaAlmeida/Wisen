# Ambiente local. Para produção, use um arquivo próprio com NODE_ENV=production e secrets fortes.
NODE_ENV=development

# Portas publicadas no localhost (acesso pelo host).
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
DATABASE_HOST_PORT=5432

# Portas e URLs dentro da rede Docker. Ao mudar portas internas, ajuste as URLs correspondentes.
FRONTEND_PORT=3000
PORT=8080
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8080/api

# Banco local existente. A porta interna do PostgreSQL é 5432. DATABASE_URL deve refletir as credenciais acima.
# Alterar a senha aqui não altera a senha de um banco já inicializado.
POSTGRES_USER=wisen
POSTGRES_PASSWORD=wisen_local
POSTGRES_DB=wisen
DATABASE_URL=postgres://wisen:wisen_local@database:5432/wisen

# Token operacional: somente servidor/CLI; nunca disponibilizar ao navegador.
# TRUST_PROXY vazio ignora IPs encaminhados. Em produção, informe apenas IPs/CIDRs dos proxies confiáveis.
OPERATIONS_TOKEN=development-only-change-this-token-before-deploy
TRUST_PROXY=

# Worker e cache do modelo dentro dos containers.
MODEL_CACHE_DIR=/models
AI_MEMORY_LIMIT=1536m
AI_CPU_LIMIT=2

# Desenvolvimento do frontend.
WATCHPACK_POLLING=true
NEXT_TELEMETRY_DISABLED=1

# Testes isolados: portas diferentes do banco e dos apps de desenvolvimento.
# TEST_DATABASE_URL e E2E_BASE_URL são calculadas pelos executores.
TEST_DATABASE_HOST_PORT=55439
E2E_BACKEND_PORT=18080
E2E_FRONTEND_PORT=18081

# MVP — IA, coleta, e-mail e domínio. Chaves privadas não são versionadas.
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna
AI_INPUT_USD_PER_MILLION=0.10
AI_OUTPUT_USD_PER_MILLION=0.50
AI_USD_BRL=6
AI_COST_MARGIN=1.2
AI_MONTHLY_LIMIT_BRL=80
AI_DAILY_USER_LIMIT=30
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=90000
COLLECTION_DAILY_LIMIT=20
COLLECTION_INTERVAL_MINUTES=30
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DAILY_LIMIT=100
PUBLIC_DOMAIN=localhost
