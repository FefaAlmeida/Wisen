-- Migration: Criar tabela de estado atual do aprendizado do usuário em relação aos conceitos
-- Data: 2026-10-27
-- Descrição: Criação da tabela de relações entre usuários e conceitos, com campos para mastery_score, estado, timestamps de revisão e métricas de memória.

CREATE TABLE usuario_conceito_dominio (
  usuario_id uuid NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
  conceito_id uuid NOT NULL REFERENCES conceitos(id) ON DELETE CASCADE,
  mastery_score numeric(4,3) NOT NULL DEFAULT 0 CHECK (mastery_score BETWEEN 0 AND 1),
  estado text NOT NULL DEFAULT 'LACUNA' CHECK (estado IN ('LACUNA', 'EM_REVISAO', 'DOMINADO')),
  ultima_revisao_em timestamptz,
  proxima_revisao_em timestamptz,
  intervalo_revisao_dias numeric(10,2) CHECK (intervalo_revisao_dias >= 0),
  estabilidade_memoria numeric(12,4) CHECK (estabilidade_memoria >= 0),
  dificuldade_memoria numeric(8,4),
  atualizado_em timestamptz NOT NULL DEFAULT now(),
  PRIMARY KEY (usuario_id, conceito_id)
);