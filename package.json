{
  "name": "wisen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "ai"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f frontend backend ai",
    "dev:status": "docker compose ps",
    "setup:model": "docker compose run --build --rm --no-deps ai npm run setup:model -w @wisen/ai",
    "db:migrate": "docker compose run --build --rm migrate",
    "test:unit": "node test/scripts/run-node-tests.js unit",
    "test:integration": "node test/scripts/run-integration.js",
    "test:frontend": "vitest run --config test/vitest.config.js",
    "test:e2e": "node test/scripts/run-e2e.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:frontend && npm run test:e2e",
    "collect": "docker compose exec -T backend node backend/src/cli.js collect",
    "search": "docker compose exec -T backend node backend/src/cli.js search",
    "build": "npm run build -w @wisen/frontend",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
