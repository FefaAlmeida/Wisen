# Desenvolvimento: opcional, apenas para mudar as portas locais.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
DATABASE_HOST_PORT=5432
# Limite do worker, ajustável conforme o tamanho dos documentos.
AI_MEMORY_LIMIT=1536m

